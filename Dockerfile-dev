# syntax=docker/dockerfile:1

FROM golang:1.26.7 AS builder
WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /bot ./cmd/bot

FROM scratch

COPY --from=builder /bot /bot
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# Dev only: bake the local .env into the image so no env flags are needed.
# Do not distribute or push this image; it contains your bot token.
USER 65532:65532
WORKDIR /data
COPY --chown=65532:65532 .env /data/.env

ENTRYPOINT ["/bot"]
